# Reference only. `forge.js provision` generates .env with a free port and
# random passwords. To set it up by hand: cp .env.example .env && edit.

# Unique per instance so several sandboxes can run side by side.
COMPOSE_PROJECT_NAME=agent-forge-myproject

# Host port, and the URL you open in the browser. Keep them in sync.
# The host part must contain a dot: Phorge rejects bare names like "localhost".
PHORGE_HOST_PORT=8080
PHORGE_BASE_URI=http://127.0.0.1:8080/
# Optional comma-separated extra URLs Phorge should accept (e.g. a LAN name).
PHORGE_ALLOWED_URIS=
PHORGE_TIMEZONE=UTC

MYSQL_ROOT_PASSWORD=change-me

# Web-loginable administrator.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_REALNAME=Administrator
ADMIN_PASSWORD=change-me

# Bot account used by the agent (API only). Its Conduit token is written to
# /var/run/phorge/agent.token inside the phorge-state volume.
AGENT_USERNAME=agent
AGENT_EMAIL=agent@example.com
AGENT_REALNAME=Agent
